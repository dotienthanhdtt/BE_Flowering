# Application
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/be_flowering

# Object storage (S3-compatible, e.g. Railway bucket)
STORAGE_ENDPOINT=https://your-bucket-endpoint
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_REGION=auto

# Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Subscriptions (RevenueCat)
REVENUECAT_API_KEY=your-revenuecat-api-key
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret
# Secret key for RC REST API v1 subscriber lookups (PremiumGuard fallback + nightly reconciliation).
# Required in production — startup will abort if missing when NODE_ENV=production.
REVENUECAT_REST_API_KEY=your-revenuecat-rest-secret-key

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# AI Services (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# 9router OpenAI-compatible gateway (used by scenario chat; falls back to Gemini if key unset).
# Set NINEROUTER_KEY in your real .env / Railway env vars — never put the value in this template.
NINEROUTER_URL=https://9router-dev.up.railway.app
NINEROUTER_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
STT_PROVIDER=openai
# Soniox realtime streaming STT (required for /ws/speech/stt)
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-preview
STT_STREAMING_PROVIDER=soniox
# Soniox TTS (POST /ai/speech/tts and WS /ws/speech/tts)
SONIOX_TTS_MODEL=tts-rt-v1
SONIOX_TTS_VOICE=Adrian
SONIOX_TTS_AUDIO_FORMAT=mp3
SONIOX_TTS_SAMPLE_RATE=24000

# Alibaba DashScope CosyVoice — TTS fallback provider (Singapore region only)
# DASHSCOPE_API_KEY is the only key required for fallback to activate.
DASHSCOPE_API_KEY=
ALIBABA_TTS_MODEL=cosyvoice-v3-flash
ALIBABA_TTS_VOICE=longanyang
ALIBABA_TTS_FORMAT=mp3
ALIBABA_TTS_SAMPLE_RATE=24000
# Content moderation — opt-in only (privacy + GDPR sub-processor concern).
ALIBABA_DATA_INSPECTION_ENABLED=false
# Hard ceiling per Alibaba WS session; prevents hung-WS resource leak.
ALIBABA_INACTIVITY_TIMEOUT_MS=15000
# Fallback wrapper: enable Alibaba on Soniox connect-time failure (3s first-audio deadline).
TTS_FALLBACK_ENABLED=true
TTS_FALLBACK_TIMEOUT_MS=3000

# SMTP (Email - for OTP/password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@flowering.app

